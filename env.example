# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy to .env and fill in your values before deploying.
# Never commit .env to version control.
# On EC2, set these via:
#   - AWS Parameter Store (recommended for secrets)
#   - EC2 instance environment (less secure)
#   - A .env file loaded by your systemd service
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (AWS RDS recommended) ──────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://bra_user:your_password@your-rds-endpoint.rds.amazonaws.com:5432/bra_db

# ── Server ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for CORS. Use * only in development.
APP_ORIGINS=https://your-frontend-domain.com,https://api.your-domain.com

# ── Worker ────────────────────────────────────────────────────────────────────
# Number of concurrent assessment threads.
# t3.medium (2 vCPU): 2  |  t3.large (2 vCPU): 2–4  |  c5.xlarge (4 vCPU): 4–6
WORKER_THREADS=2

# ── Gunicorn (set in your systemd service or start script) ───────────────────
# Keep workers=1 until you migrate job_queue to Redis/SQS
# GUNICORN_WORKERS=1
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_TIMEOUT=120
